# environments and caches
.venv/
__pycache__/
__marimo__/
*.part
.DS_Store

# raw downloads and build output
data/raw/
dist/

# public/ holds files derived from third-party data whose terms do not allow redistribution
# (StatsBomb, Metrica) or that are regenerated by scripts/prepare_data.py. Only small research
# tables and CC0 data are tracked.
public/*
!public/*.json
!public/intl_results.csv.gz
!public/intl_shootouts.csv
!public/tm_age_curve.csv
!public/statsbomb-logo.png
!public/snapshots/
!public/snapshots/*.jpg
!public/players/
!public/players/*.jpg

# persistent results of the heavy models (rebuilt automatically)
.cache/
_site/
